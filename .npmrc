# Neither sharp (Next.js image-optimization, unused — this app has no
# next/image calls and uses output: "export", which has no image-optimization
# server anyway) nor unrs-resolver (an ESLint tooling dependency that already
# runs clean without its native build) need their install scripts to run.
# pnpm 10+ refuses to run any dependency's build scripts without explicit
# approval and, on some hosts/versions, exits non-zero over just these two
# rather than only warning — skipping install scripts entirely sidesteps that
# regardless of which pnpm version or corepack setup the host actually uses.
ignore-scripts=true
